{
  "name": "actorboy",
  "type": "module",
  "version": "0.1.0",
  "description": "Elixir/OTP's runtime model on web standards: Result, Task, Stream, Supervisor and distributed Node \u2014 one failure vocabulary, zero runtime dependencies",
  "author": "Izel Nakri",
  "license": "MIT",
  "keywords": [
    "elixir",
    "erlang",
    "otp",
    "result",
    "task",
    "stream",
    "supervisor",
    "supervision tree",
    "error handling",
    "railway oriented programming",
    "failure",
    "typed errors",
    "promise",
    "lazy promise",
    "retry",
    "distributed",
    "actor",
    "hot code reload",
    "hot code upgrade",
    "zero dependencies",
    "universal",
    "browser",
    "deno",
    "node"
  ],
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./result": {
      "types": "./dist/lib/result/index.d.ts",
      "default": "./dist/lib/result/index.js"
    },
    "./failure": {
      "types": "./dist/lib/result/failure.d.ts",
      "default": "./dist/lib/result/failure.js"
    },
    "./task": {
      "types": "./dist/lib/task/index.d.ts",
      "default": "./dist/lib/task/index.js"
    },
    "./stream": {
      "types": "./dist/lib/stream/index.d.ts",
      "default": "./dist/lib/stream/index.js"
    },
    "./supervisor": {
      "types": "./dist/lib/supervisor/index.d.ts",
      "default": "./dist/lib/supervisor/index.js"
    },
    "./node": {
      "types": "./dist/lib/node/index.d.ts",
      "default": "./dist/lib/node/index.js"
    },
    "./node/hub": {
      "types": "./dist/lib/node/hub.d.ts",
      "default": "./dist/lib/node/hub.js"
    },
    "./pubsub": {
      "types": "./dist/lib/pubsub/index.d.ts",
      "default": "./dist/lib/pubsub/index.js"
    },
    "./presence": {
      "types": "./dist/lib/presence/index.d.ts",
      "default": "./dist/lib/presence/index.js"
    },
    "./telemetry": {
      "types": "./dist/lib/telemetry/index.d.ts",
      "default": "./dist/lib/telemetry/index.js"
    },
    "./raft": {
      "types": "./dist/lib/raft/index.d.ts",
      "default": "./dist/lib/raft/index.js"
    },
    "./job": {
      "types": "./dist/lib/job/index.d.ts",
      "default": "./dist/lib/job/index.js"
    },
    "./saga": {
      "types": "./dist/lib/saga/index.d.ts",
      "default": "./dist/lib/saga/index.js"
    },
    "./cache": {
      "types": "./dist/lib/cache/index.d.ts",
      "default": "./dist/lib/cache/index.js"
    },
    "./logger": {
      "types": "./dist/lib/logger/index.d.ts",
      "default": "./dist/lib/logger/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "actorboy": "bin/actorboy.js"
  },
  "files": [
    "bin/",
    "dist/",
    "lib/",
    "mod.ts",
    "docs/",
    "examples/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "format": "prettier --check \"lib/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\" \"scripts/**/*.ts\" \"benches/**/*.ts\" \"bin/**/*.js\" \"*.ts\" \"examples/**/*.ts\" \"package.json\" \".github/**/*.yml\"",
    "format:fix": "prettier --write \"lib/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\" \"scripts/**/*.ts\" \"benches/**/*.ts\" \"bin/**/*.js\" \"*.ts\" \"examples/**/*.ts\" \"package.json\" \".github/**/*.yml\"",
    "lint": "deno lint lib/ test/ scripts/ benches/ examples/ mod.ts cli.ts",
    "lint:docs": "node scripts/lint-docs.js",
    "typecheck": "deno check --doc lib/ mod.ts cli.ts examples/",
    "test": "node --test \"test/**/*-test.ts\"",
    "test:junit": "node -e \"require('node:fs').mkdirSync('tmp', { recursive: true })\" && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=tmp/junit-node.xml \"test/**/*-test.ts\"",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('tmp', { recursive: true })\" && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=tmp/junit-node.xml --test-reporter=lcov --test-reporter-destination=tmp/lcov.info \"test/**/*-test.ts\"",
    "test:deno": "deno test --allow-all --no-check --parallel \"test/**/*-test.ts\"",
    "test:deno:junit": "deno test --allow-all --no-check --parallel --junit-path=tmp/junit-deno.xml \"test/**/*-test.ts\"",
    "test:aplus": "node test/task/promises-aplus.ts",
    "test:doctest": "deno test --doc --allow-env --allow-read=/tmp --allow-sys lib/ mod.ts cli.ts",
    "docs": "deno doc --html --name=\"actorboy\" --output=docs/api 'lib/**/*.ts' mod.ts README.md",
    "changelog:unreleased": "git-cliff --unreleased --strip all",
    "changelog:preview": "git-cliff",
    "changelog:update": "git-cliff --output CHANGELOG.md"
  },
  "engines": {
    "node": ">=22.0.0",
    "deno": ">=2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izelnakri/actorboy.git"
  },
  "homepage": "https://github.com/izelnakri/actorboy#readme",
  "bugs": {
    "url": "https://github.com/izelnakri/actorboy/issues"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "postgres": "^3.4.9",
    "prettier": "^3.9.5",
    "promises-aplus-tests": "^2.1.2",
    "qunitx": "^1.2.18",
    "typescript": "^7.0.2",
    "ws": "^8.21.0"
  },
  "volta": {
    "node": "24.18.0"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "arrowParens": "always"
  },
  "overrides": {
    "promises-aplus-tests": {
      "mocha": {
        ".": "^11.7.1",
        "diff": "^8.0.3",
        "serialize-javascript": "^7.0.5"
      },
      "underscore": "^1.13.7"
    }
  }
}
