{
  "name": "@izelnakri/actorboy",
  "version": "0.1.0",
  "license": "MIT",
  "nodeModulesDir": "auto",
  "exports": {
    ".": "./mod.ts",
    "./result": "./lib/result/index.ts",
    "./failure": "./lib/result/failure.ts",
    "./task": "./lib/task/index.ts",
    "./stream": "./lib/stream/index.ts",
    "./supervisor": "./lib/supervisor/index.ts",
    "./node": "./lib/node/index.ts",
    "./node/hub": "./lib/node/hub.ts",
    "./pubsub": "./lib/pubsub/index.ts",
    "./presence": "./lib/presence/index.ts",
    "./telemetry": "./lib/telemetry/index.ts",
    "./raft": "./lib/raft/index.ts",
    "./job": "./lib/job/index.ts",
    "./saga": "./lib/saga/index.ts",
    "./cache": "./lib/cache/index.ts",
    "./logger": "./lib/logger/index.ts"
  },
  "publish": {
    "include": ["lib/", "mod.ts", "cli.ts", "deno.json", "README.md", "LICENSE", "docs/"],
    "exclude": ["docs/api/"]
  },
  "imports": {
    "ws": "npm:ws@^8.21.0",
    "qunitx": "npm:qunitx@^1.2.18",
    // examples/ only, and dev-only at that: `typecheck` runs `deno check --doc` over the
    // examples as well as lib/, so the driver an example imports has to resolve. lib/ defines
    // the Store seam; an application brings its own backend — nothing published depends on it.
    "postgres": "npm:postgres@^3.4.9"
  },
  // Stated, not defaulted: deno reads the sibling tsconfig.json (which exists for the npm
  // `tsc` build and therefore declares node/DOM libs), and its `lib` would otherwise displace
  // `deno.ns` — turning every `Deno.*` reference in a generated doctest into TS2304. Naming
  // the libs here keeps deno's own view authoritative for check, test and lint.
  "compilerOptions": {
    "lib": ["deno.ns", "esnext", "dom", "dom.iterable"]
  },
  // Benchmarks are a deno-only surface (`Deno.bench`), so they live as tasks rather than npm
  // scripts. `bench:check` runs each file in its own subprocess and compares against the
  // committed baseline in benches/results.json — see scripts/check-benchmarks.ts.
  "tasks": {
    "bench": "deno bench --allow-all benches/result.bench.ts benches/task.bench.ts benches/stream.bench.ts benches/node.bench.ts",
    "bench:check": "deno run --allow-all scripts/check-benchmarks.ts --files benches/result.bench.ts benches/task.bench.ts benches/stream.bench.ts benches/node.bench.ts",
    "bench:update": "deno run --allow-all scripts/check-benchmarks.ts --save --files benches/result.bench.ts benches/task.bench.ts benches/stream.bench.ts benches/node.bench.ts"
  },
  "lint": {
    "rules": {
      "exclude": ["no-process-global", "no-node-globals", "no-window"]
    }
  }
}
